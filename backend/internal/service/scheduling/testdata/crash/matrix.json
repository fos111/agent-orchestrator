{
  "cases": [
    {
      "id": "reservation-committed-dependency-pending",
      "phase": "reserve",
      "before": {
        "schedulingState": "blocked",
        "blockedReason": "dependency_pending",
        "provisionState": "queued",
        "hasWorkspace": false,
        "hasRuntime": false,
        "isTerminated": false,
        "dependencyFact": "pending",
        "projectFull": false,
        "teamFull": false,
        "launchResult": "not_attempted"
      },
      "recovery": "boot",
      "expected": {
        "schedulingState": "blocked",
        "blockedReason": "dependency_pending",
        "provisionState": "queued",
        "launched": false,
        "launchAttempted": false,
        "isTerminated": false,
        "admissionOverride": false
      },
      "why": "A reservation is durable before it owns a workspace. Recovery re-evaluates the edge; a dependency that has not reached its required state leaves the row blocked with no launch."
    },
    {
      "id": "dependency-satisfied-before-recovery",
